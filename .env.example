# Copie para .env e preencha. Gere cada senha com `openssl rand -hex 24` (hex: segura em URL).
# O m4mini define as próprias senhas; não há default.

# Superusuário/dono do banco: só o serviço `migrate` (e você, do host) usa.
POSTGRES_PASSWORD=
# Papel entre_nos_app, sem bypass de RLS: é com ele que o app conecta (ADR 0005).
APP_DB_PASSWORD=

# Do host (pnpm db:migrate, pnpm test:db, pnpm dev), apontando para 127.0.0.1:5433:
#   MIGRATION_DATABASE_URL=postgres://entre_nos:<POSTGRES_PASSWORD>@127.0.0.1:5433/entre_nos
#   DATABASE_URL=postgres://entre_nos_app:<APP_DB_PASSWORD>@127.0.0.1:5433/entre_nos
MIGRATION_DATABASE_URL=
DATABASE_URL=
PORT=3000

# Backup (ADR 0003): WAL-G arquiva o WAL e faz backups base diários num bucket S3-compatível.
# Só os serviços `db` e `backup` recebem estas variáveis; o app nunca as vê (ADR 0005).
# Endpoint:
#   R2:    https://<account_id>.r2.cloudflarestorage.com   (BACKUP_S3_REGION=auto)
#   B2:    https://s3.<region>.backblazeb2.com              (BACKUP_S3_REGION=<region>)
#   local: http://s3-local:9000                             (BACKUP_S3_REGION=us-east-1; suba com --profile local-s3)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PATH=entre-nos
BACKUP_S3_REGION=
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Quantos backups base completos manter no bucket.
BACKUP_RETAIN_FULL=14
# Portas locais (só 127.0.0.1): S3 local (API e console) e o Postgres restaurado para inspeção.
S3_LOCAL_PORT=9105
S3_LOCAL_CONSOLE_PORT=9106
RESTORE_DB_PORT=5445

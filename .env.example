# Copie para .env e preencha. Gere cada senha com `openssl rand -hex 24` (hex: segura em URL).
# O m4mini define as próprias senhas; não há default.

# Superusuário/dono do banco: só o serviço `migrate` (e você, do host) usa.
POSTGRES_PASSWORD=
# Papel entre_nos_app, sem bypass de RLS: é com ele que o app conecta (ADR 0005).
APP_DB_PASSWORD=

# Do host (pnpm db:migrate, pnpm test:db, pnpm dev), apontando para 127.0.0.1:5433:
#   MIGRATION_DATABASE_URL=postgres://entre_nos:<POSTGRES_PASSWORD>@127.0.0.1:5433/entre_nos
#   DATABASE_URL=postgres://entre_nos_app:<APP_DB_PASSWORD>@127.0.0.1:5433/entre_nos
MIGRATION_DATABASE_URL=
DATABASE_URL=
PORT=3000

# Link mágico (Better Auth).
# Segredo das sessões e tokens: gere com `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# Base pública dos links mágicos (em produção, https).
APP_URL=
# Remetente dos e-mails (em produção, num domínio verificado no Resend).
MAIL_FROM=
# Produção: chave do Resend, definida pela dona do produto. Vazia → envia por SMTP_URL.
RESEND_API_KEY=
# Dev/e2e: capturador de e-mail (serviço `mail` do compose, perfil dev).
SMTP_URL=smtp://127.0.0.1:1025
MAILPIT_URL=http://127.0.0.1:8025
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
# Porta do front em dev (vite).
WEB_PORT=5173

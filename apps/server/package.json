{
  "name": "@entre-nos/server",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node src/index.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@entre-nos/contracts": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "better-auth": "^1.7.16",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "nodemailer": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11"
  }
}
